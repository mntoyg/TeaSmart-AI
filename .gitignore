# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets and local configuration
.env

# Datasets and model weights are never committed
data/
*.onnx
# ...except the one graph the PWA loads. 16.8 MB, committed on purpose: a fresh
# checkout has to be able to run the demo without a GPU and without rebuilding
# the model. The int8 graph stays ignored - it fails the parity bound in spec
# section 8.4 and must not be shipped by accident.
!frontend/public/models/teasmart-v1.onnx
*.pt
*.pth

# Node / frontend build output
node_modules/
dist/

# Plan-execution scratch space
.superpowers/

.DS_Store

# ml training environment
ml/.venv/

# Secrets and credentials
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
kaggle.json
hf_token*
.huggingface/
**/credentials.json
**/service-account*.json
.claude/settings.local.json

# Private imagery and documents: only the README is tracked
private/*
!private/README.md

# Interrupted downloads
*.part
