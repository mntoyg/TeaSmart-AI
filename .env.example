# Copy to backend/.env and adjust. Every value below is a safe default, not a secret.
TEASMART_APP_NAME=TeaSmart AI
TEASMART_MODEL_VERSION=teasmart-v1

# JSON array; must stay an explicit allowlist, never a wildcard.
TEASMART_CORS_ORIGINS=["http://localhost:5173"]

# Upload hardening
TEASMART_MAX_UPLOAD_BYTES=8388608
TEASMART_MAX_IMAGE_PIXELS=40000000

# Stage 1 quality gate
TEASMART_BLUR_THRESHOLD=80.0
TEASMART_EXPOSURE_MIN_MEAN=40.0
TEASMART_EXPOSURE_MAX_MEAN=215.0
TEASMART_CLIP_MAX_PCT=0.10

# Absolute path override; defaults to backend/app/kb/diseases.json
# TEASMART_KB_PATH=
